[HarmonyPatch]
public static class UpdateCraftingSystemPatch
{
    [HarmonyPatch(typeof(UpdateCraftingSystem), nameof(UpdateCraftingSystem.OnCreate))]
    [HarmonyPrefix]
    public static void OnCreatePrefix(UpdateCraftingSystem __instance)
    {
        Plugin.BepinLogger.LogInfo("[AP] UpdateCraftingSystem.OnCreate [PREFIX]");
        CheckStationEntitiesForRecipes();
    }

    [HarmonyPatch(typeof(UpdateCraftingSystem), nameof(UpdateCraftingSystem.OnCreate))]
    [HarmonyPostfix]
    public static void OnCreatePostfix(UpdateCraftingSystem __instance)
    {
        Plugin.BepinLogger.LogInfo("[AP] UpdateCraftingSystem.OnCreate [POSTFIX]");
        CheckStationEntitiesForRecipes();
    }

    [HarmonyPatch(typeof(UpdateCraftingSystem), nameof(UpdateCraftingSystem.OnUpdate))]
    [HarmonyPrefix]
    public static void OnUpdatePrefix(UpdateCraftingSystem __instance)
    {
        Plugin.BepinLogger.LogInfo("[AP] UpdateCraftingSystem.OnUpdate [PREFIX]");
        CheckStationEntitiesForRecipes();
    }

    [HarmonyPatch(typeof(UpdateCraftingSystem), nameof(UpdateCraftingSystem.OnUpdate))]
    [HarmonyPostfix]
    public static void OnUpdatePostfix(UpdateCraftingSystem __instance)
    {
        Plugin.BepinLogger.LogInfo("[AP] UpdateCraftingSystem.OnUpdate [POSTFIX]");
        CheckStationEntitiesForRecipes();
    }

    private static void CheckStationEntitiesForRecipes()
    {
        var em = Plugin.EntityManager;
        var query = em.CreateEntityQuery(ComponentType.ReadOnly<UnlockedRecipeElement>());

        if (query.IsEmpty)
        {
            Plugin.BepinLogger.LogDebug("[AP] UpdateCraftingSystem: No recipe elements found");
            return;
        }

        var recipeEntities = query.ToEntityArray(Allocator.Temp);
        Plugin.BepinLogger.LogDebug($"[AP] UpdateCraftingSystem: Checking {recipeEntities.Length} entities for recipe elements");

        foreach (var entity in recipeEntities)
        {
            var recipeBuffer = em.GetBuffer<UnlockedRecipeElement>(entity);
            Plugin.BepinLogger.LogDebug($"[AP] UpdateCraftingSystem: Entity has {recipeBuffer.Length} unlocked recipes");
        }
    }
}

