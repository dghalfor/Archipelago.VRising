# PowerShell script to rebuild Tech-to-Guid, Guid-to-Tech, and Tech-to-Recipe mappings
# This script consolidates all mapping relationships and fixes imprecise mappings

$dataDir = Split-Path -Parent $MyInvocation.MyCommandPath
$techToGuidPath = Join-Path $dataDir "TechToGuid.json"
$guidToTechPath = Join-Path $dataDir "GuidToTech.json"
$techToRecipePath = Join-Path $dataDir "TechToRecipe.json"
$recipeToGuidPath = Join-Path $dataDir "RecipeToGuid.json"

# Load existing data
$techToGuid = Get-Content $techToGuidPath -Raw | ConvertFrom-Json
$guidToTech = Get-Content $guidToTechPath -Raw | ConvertFrom-Json
$techToRecipe = Get-Content $techToRecipePath -Raw | ConvertFrom-Json
$recipeToGuid = Get-Content $recipeToGuidPath -Raw | ConvertFrom-Json

Write-Host "Loaded mappings:"
Write-Host "  TechToGuid: $($techToGuid | Get-Member -MemberType NoteProperty | Measure-Object).Count entries"
Write-Host "  GuidToTech: $($guidToTech | Get-Member -MemberType NoteProperty | Measure-Object).Count entries"
Write-Host "  TechToRecipe: $($techToRecipe | Get-Member -MemberType NoteProperty | Measure-Object).Count entries"
Write-Host "  RecipeToGuid: $($recipeToGuid | Get-Member -MemberType NoteProperty | Measure-Object).Count entries"

# Create hashtables for easier manipulation
$ttgHash = @{}
$gtHash = @{}
$trHash = @{}
$rgHash = @{}

# Convert PSCustomObjects to hashtables
$techToGuid | Get-Member -MemberType NoteProperty | ForEach-Object {
    $ttgHash[$_.Name] = $techToGuid.$($_.Name)
}

$guidToTech | Get-Member -MemberType NoteProperty | ForEach-Object {
    $gtHash[$_.Name] = $guidToTech.$($_.Name)
}

$techToRecipe | Get-Member -MemberType NoteProperty | ForEach-Object {
    $trHash[$_.Name] = $techToRecipe.$($_.Name)
}

$recipeToGuid | Get-Member -MemberType NoteProperty | ForEach-Object {
    $rgHash[$_.Name] = $recipeToGuid.$($_.Name)
}

Write-Host "`nProcessing mappings..."

# Fixed mappings - known weapon mappings that need correction
$fixedMappings = @{
    "Tech_Weapon_Axe_T04" = "Recipe_Weapon_Axe_T04_Copper_Reinforced"
}

# Count fixes
$fixesApplied = 0

# Apply fixed mappings
foreach ($tech in $fixedMappings.Keys) {
    $correctRecipe = $fixedMappings[$tech]
    if ($ttgHash.ContainsKey($tech) -and $rgHash.ContainsKey($correctRecipe)) {
        $techGuid = $ttgHash[$tech]
        $recipeGuid = $rgHash[$correctRecipe]

        if ($trHash.ContainsKey($tech)) {
            $oldRecipe = $trHash[$tech].recipe
            Write-Host "Fixing $tech`:  $oldRecipe -> $correctRecipe"
            $fixesApplied++
        }

        $trHash[$tech] = @{
            recipe = $correctRecipe
            recipe_guid = $recipeGuid
            tech_guid = $techGuid
            status = "fixed_mapping"
            note = "Manually corrected weapon recipe mapping"
        }
    }
}

# Rebuild smart suggestions for remaining entries
# Match Tech names with Recipe names using intelligent patterns
$remainingImprecise = 0
foreach ($tech in $ttgHash.Keys) {
    if (-not $trHash.ContainsKey($tech)) {
        continue
    }

    $entry = $trHash[$tech]

    # Skip if already fixed
    if ($entry.status -eq "fixed_mapping") {
        continue
    }

    $techGuid = $ttgHash[$tech]

    # Try to find exact recipe matches by tech name patterns
    $recipeCandidates = @()

    # Extract the meaningful part of tech name (remove Tech_ prefix)
    $techPart = $tech -replace "^Tech_", ""

    # Search for recipes that contain these key terms
    foreach ($recipe in $rgHash.Keys) {
        if ($recipe -like "*$techPart*") {
            $recipeCandidates += $recipe
        }
    }

    # Prefer Recipe_ prefix recipes over Item_Ingredient_Book recipes
    $preferredRecipes = $recipeCandidates | Where-Object {$_ -like "Recipe_*"}
    if ($preferredRecipes.Count -gt 0) {
        $bestRecipe = $preferredRecipes[0]
    } else {
        $bestRecipe = $recipeCandidates[0]
    }

    if ($bestRecipe -ne $entry.recipe -and $bestRecipe) {
        Write-Host "Suggestion for $tech`: $($entry.recipe) -> $bestRecipe"
        $entry.recipe = $bestRecipe
        $entry.recipe_guid = $rgHash[$bestRecipe]
        $entry.status = "imprecise_match"
        $entry.note = "Name-based matching - may need manual review"
        $remainingImprecise++
    }
}

Write-Host "`nSummary:"
Write-Host "  Fixes applied: $fixesApplied"
Write-Host "  Remaining imprecise: $remainingImprecise"

# Convert back to PSCustomObjects and sort
$ttgOut = [ordered]@{}
$gtOut = [ordered]@{}
$trOut = [ordered]@{}

$ttgHash.Keys | Sort-Object | ForEach-Object {
    $ttgOut[$_] = $ttgHash[$_]
}

$gtHash.Keys | Sort-Object | ForEach-Object {
    $gtOut[$_] = $gtHash[$_]
}

$trHash.Keys | Sort-Object | ForEach-Object {
    $trOut[$_] = $trHash[$_]
}

# Save the updated mappings
$ttgOut | ConvertTo-Json -Depth 3 | Set-Content $techToGuidPath
$gtOut | ConvertTo-Json -Depth 3 | Set-Content $guidToTechPath
$trOut | ConvertTo-Json -Depth 3 | Set-Content $techToRecipePath

Write-Host "`nMappings saved:"
Write-Host "  $techToGuidPath"
Write-Host "  $guidToTechPath"
Write-Host "  $techToRecipePath"
