#!/usr/bin/env python3
import json
import os

# File paths
data_dir = r"C:\Users\dghal\source\repos\Archipelago.VRising\APVRising\Data"
tech_to_guid_file = os.path.join(data_dir, "TechToGuid.json")
recipe_to_guid_file = os.path.join(data_dir, "RecipeToGuid.json")

# Load existing mappings
print(f"Loading from {tech_to_guid_file}")
print(f"File exists: {os.path.exists(tech_to_guid_file)}")
with open(tech_to_guid_file, 'r', encoding='utf-8') as f:
    content = f.read()
    print(f"File size: {len(content)} bytes")
    if content:
        tech_to_guid = json.loads(content)
    else:
        print("ERROR: File is empty!")
        tech_to_guid = {}

print(f"Loading from {recipe_to_guid_file}")
print(f"File exists: {os.path.exists(recipe_to_guid_file)}")
with open(recipe_to_guid_file, 'r', encoding='utf-8') as f:
    content = f.read()
    print(f"File size: {len(content)} bytes")
    if content:
        recipe_to_guid = json.loads(content)
    else:
        print("ERROR: File is empty!")
        recipe_to_guid = {}

# Create GuidToTech mapping (invert TechToGuid)
guid_to_tech = {str(v): k for k, v in tech_to_guid.items()}

# Create TechToRecipe mapping
tech_to_recipe = {}
for tech_name in tech_to_guid.keys():
    if tech_name.startswith("Tech_"):
        # Try exact match first (Tech_X -> Recipe_X)
        recipe_base = tech_name.replace("Tech_", "Recipe_")

        if recipe_base in recipe_to_guid:
            tech_to_recipe[tech_name] = {
                "recipe": recipe_base,
                "recipe_guid": recipe_to_guid[recipe_base],
                "tech_guid": tech_to_guid[tech_name],
                "status": "exact_match"
            }
        else:
            # Try partial matches (look for recipes containing the tech name components)
            found = False
            tech_components = tech_name.replace("Tech_", "").lower()

            for recipe_name, recipe_guid in recipe_to_guid.items():
                recipe_lower = recipe_name.replace("Recipe_", "").lower()
                if recipe_lower.startswith(tech_components) or tech_components in recipe_lower:
                    tech_to_recipe[tech_name] = {
                        "recipe": recipe_name,
                        "recipe_guid": recipe_guid,
                        "tech_guid": tech_to_guid[tech_name],
                        "status": "imprecise_match",
                        "note": "Partial name match - may not be accurate"
                    }
                    found = True
                    break

            if not found:
                tech_to_recipe[tech_name] = {
                    "recipe": None,
                    "recipe_guid": None,
                    "tech_guid": tech_to_guid[tech_name],
                    "status": "no_match",
                    "note": "No matching recipe found"
                }

# Create GuidToRecipe mapping
guid_to_recipe = {str(v): k for k, v in recipe_to_guid.items()}

# Save the new mappings
guid_to_tech_file = os.path.join(data_dir, "GuidToTech.json")
with open(guid_to_tech_file, 'w') as f:
    json.dump(guid_to_tech, f, indent=2)

tech_to_recipe_file = os.path.join(data_dir, "TechToRecipe.json")
with open(tech_to_recipe_file, 'w') as f:
    json.dump(tech_to_recipe, f, indent=2)

guid_to_recipe_file = os.path.join(data_dir, "GuidToRecipe.json")
with open(guid_to_recipe_file, 'w') as f:
    json.dump(guid_to_recipe, f, indent=2)

print(f"Created GuidToTech.json with {len(guid_to_tech)} entries")
print(f"Created TechToRecipe.json with {len(tech_to_recipe)} entries")
print(f"Created GuidToRecipe.json with {len(guid_to_recipe)} entries")

# Show statistics
exact_matches = sum(1 for v in tech_to_recipe.values() if v.get("status") == "exact_match")
imprecise_matches = sum(1 for v in tech_to_recipe.values() if v.get("status") == "imprecise_match")
no_matches = sum(1 for v in tech_to_recipe.values() if v.get("status") == "no_match")

print("\nTechToRecipe Statistics:")
print(f"  Exact matches: {exact_matches}")
print(f"  Imprecise matches: {imprecise_matches}")
print(f"  No matches: {no_matches}")
